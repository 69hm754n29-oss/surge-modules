#!name=AnyRouter 保活 · 挤
#!desc=按需保活：面板下拉刷新立即向 anyrouter.top 挤一次，面板显示上次保活成功时间。成功会发系统通知。定时保活默认关闭（脚本行被注释，Surge 完全不加载、不耗电），需要连续保活时把「定时保活」参数改成任务名即可。
#!author=Minis
#!system=ios
#!arguments=定时保活:"#",生效时段:"全天",接口令牌:sk-在这里填,执行间隔分钟:"2",并发份数:"3",模型:"gpt-6-astra",失败重试次数:"0",成功通知:"true",失败也通知:"false",输出调试日志:"false"
#!arguments-desc=- 定时保活: 填 # = 关闭（默认）。整条 cron 脚本行会被注释掉，Surge 根本不加载它，一点电都不耗。\n想开启就把它改成任务名，例如 ["保活定时","AnyRouter 保活"]。\n\n- 生效时段: 只在定时任务里生效。填「全天」= 不限；或填小时区间，如 ["8-23","22-6"]（支持跨零点）。面板下拉不受它限制。\n\n- 接口令牌: anyrouter 的 sk- 令牌，必填，形如 sk-xxxx。\n\n- 执行间隔分钟: ["2","3","5","6","10","15","30"] 只在开启定时保活时有效。Surge 官方约束：cron 每小时触发超过 10 次会触发耗电警告，想避开就选 6 或更大。\n\n- 并发份数: ["1","3","5","10","20"] 每次同时发几份。站点偶发 500 渠道满，多打几份就是提高至少一份成功的概率。\n\n- 模型: 默认 gpt-6-astra。\n\n- 失败重试次数: ["0","1","2","3"] 单份失败后的重试次数，0 = 失败就等下一次。\n\n- 成功通知: ["true","false"] 保活成功时弹系统通知。定时任务建议保持 true。\n\n- 失败也通知: ["false","true"] 失败时也弹通知。默认关（常驻时避免被刷屏）。\n\n- 输出调试日志: ["false","true"] true 时在 Surge 脚本日志里输出明细。

[Panel]
AnyRouter 保活 = title="AnyRouter 保活 · 挤",content="下拉刷新：立即挤一次，查看上次成功时间与累计统计",style=info,script-name=AnyRouter 保活面板

[Script]
# 定时保活：参数「定时保活」填 # 时，下面这行会被注释掉，脚本不加载、不运行
{{{定时保活}}} = type=cron,cronexp="*/{{{执行间隔分钟}}} * * * *",wake-system=1,timeout=300,script-path=https://raw.githubusercontent.com/69hm754n29-oss/surge-modules/main/anyrouter/anyrouter_keepalive.js,script-update-interval=86400,argument=mode=run&WINDOW={{{生效时段}}}&API_KEY={{{接口令牌}}}&CONCURRENCY={{{并发份数}}}&MODEL={{{模型}}}&RETRY={{{失败重试次数}}}&LOG={{{输出调试日志}}}&NOTIFY_OK={{{成功通知}}}&NOTIFY_FAIL={{{失败也通知}}}

# 面板：下拉刷新立即挤一次（不受「定时保活」开关和时段影响）
AnyRouter 保活面板 = type=generic,timeout=300,script-path=https://raw.githubusercontent.com/69hm754n29-oss/surge-modules/main/anyrouter/anyrouter_keepalive.js,script-update-interval=86400,argument=mode=panel&WINDOW={{{生效时段}}}&API_KEY={{{接口令牌}}}&CONCURRENCY={{{并发份数}}}&MODEL={{{模型}}}&RETRY={{{失败重试次数}}}&LOG={{{输出调试日志}}}&NOTIFY_OK={{{成功通知}}}&NOTIFY_FAIL={{{失败也通知}}}

