#!name=航旅纵横去广告
#!desc=精简首页、精简我的页面。由杏九的 Loon 插件（xingjiu29/Umetrip）每次自动转换为 Surge 模块。
#!author=杏九 / Minis
#!category=Minis
#!system=ios
#!version=2026-11-12.1517

[Rule]
DOMAIN,sensors.umetrip.com.cn,REJECT
DOMAIN,analytics.umetrip.com,REJECT

[URL Rewrite]
^https?:\/\/(discardrp|startup)\.umetrip\.com\/gateway\/api\/umetrip\/native - reject

[Map Local]
^https?:\/\/oss\.umetrip\.com\/fs\/advert\/polite data-type=text data="{}" status-code=200 header="Content-Type: application/json"

[Script]
umetrip.native = type=http-response,pattern=^https?:\/\/(bkclient|umerp|home|umehome|sns|appmsg)\.umetrip\.com(\.cn)?\/gateway\/api\/umetrip\/native(?:\?.*)?$,requires-body=1,binary-body-mode=1,timeout=30,max-size=300000,engine=webview,script-path=https://raw.githubusercontent.com/xingjiu29/Umetrip/refs/heads/main/umetrip.js?v=4

[MITM]
hostname = %APPEND% umerp.umetrip.com, umerp.umetrip.com.cn, home.umetrip.com, bkclient.umetrip.com.cn, discardrp.umetrip.com, startup.umetrip.com, oss.umetrip.com, umehome.umetrip.com, sns.umetrip.com, appmsg.umetrip.com
